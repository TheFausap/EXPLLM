   "source": [
    "# QALF: Quantum Associative Language Field — Google Colab Notebook\n\nThis notebook contains all the core QALF code to run on Colab."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 1. Setup & Imports"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": ["# Install required packages (Colab)\n!pip install --quiet torch==2.3.0 transformers datasets"
  ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom dataclasses import dataclass\nfrom collections import Counter\nimport random\nimport json\nimport math\nimport re\nfrom pathlib import Path\nfrom typing import Optional, Dict, Any, List, Iterable\n\nprint('PyTorch:', torch.__version__)\nprint('GPU available:', torch.cuda.is_available())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 2. QuantumTokenizer — Regex tokenization"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "@dataclass\nclass EncodedExample:\n    prompt: List[int]\n    reply: List[int]\n    sequence: List[int]\n\nSPECIAL_TOKENS = ['<pad>', '<unk>', '<bos>', '<eos>', '<user>', '<assistant>']\n\nclass QuantumTokenizer:\n    def __init__(self, vocab: List[str]):\n        seen = set(); ordered = []\n        for t in SPECIAL_TOKENS + vocab:\n            if t not in seen: ordered.append(t); seen.add(t)\n        self.vocab, self.token_to_id = ordered, {t:i for i,t in enumerate(ordered)}\n        self.pad_id, self.unk_id = self.token_to_id['<pad>'], self.token_to_id['<unk>']\n        self.bos_id, self.eos_id = self.token_to_id['<bos>'], self.token_to_id['<eos>']\n        self.user_id, self.assistant_id = self.token_to_id['<user>'], self.token_to_id['<assistant>']\n    \n    @classmethod\n    def build(cls, texts, vocab_size=4096, min_count=1):\n        counts = Counter(); capacity = max(vocab_size - 6, 0)\n        vocab = [t for t,c in counts.most_common() if c>=min_count and t not in SPECIAL_TOKENS][:capacity]\n        return cls(vocab)\n    \n    def encode(self, text): return [self.token_to_id.get(t, self.unk_id) for t in tokenize(text)]\n    \n    def decode(self, ids, skip_special=True):\n        toks = [self.vocab[i] for i in ids if 0<=i<len(self.vocab) and (not skip_special or self.vocab[i] not in SPECIAL_TOKENS)]\n        return detokenize(toks)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "TOKEN_PATTERN = re.compile(r'<[^>]+>|[A-Za-z]+(?:\'[A-Za-z]+)?|\d+|[^\sA-Za-z\d]")\n\ndef tokenize(text): return [m.group(0).lower() for m in TOKEN_PATTERN.finditer(text)]\n\ndef detokenize(toks):\n    text, nospace_b = '', {'.',',','!','?',';',':',')',']','}'}\n    nospace_a, quote_open = {'(','[','{'}, True\n    for t in toks:\n        if not text: text = t; continue\n        if t=='\"': text += ' "' if quote_open else '"'; quote_open = not quote_open\n        elif t in nospace_b: text += t\n        elif text[-1] in nospace_a: text += t\n        else: text += ' ' + t\n    return text[0].upper()+text[1:] if text else text"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Demo\ntok = QuantumTokenizer.build(['hello world', 'foo bar', 'quantum language field'], 100)\nprint('Vocab[:10]:', tok.vocab[:10])\nprint('Encoded Hello world:', tok.encode('Hello world!'))\nprint('Decoded [1,2,3,4]:', tok.decode([1,2,3,4]))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 3. State Math — Complex arithmetic, density matrices"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def normalize_complex(states, eps=1e-8):\n    norm = torch.linalg.vector_norm(states, dim=-1, keepdim=True).clamp_min(eps)\n    return states / norm\n\ndef density_from_state(state, eps=1e-8):\n    state = normalize_complex(state, eps)\n    rho = state.unsqueeze(-1) * state.conj().unsqueeze(-2)\n    tr = torch.diagonal(rho, dim1=-2, dim2=-1).sum(dim=-1).real.clamp_min(eps)\n    return rho / tr[..., None, None].to(rho.dtype)\n\ndef is_hermitian(matrix, atol=1e-5):\n    return torch.allclose(matrix, matrix.conj().transpose(-1, -2), atol=atol, rtol=0.0)\n\ndef trace_real(matrix):\n    return torch.diagonal(matrix, dim1=-2, dim2=-1).sum(dim=-1).real\n\ndef purity(matrix):\n    return (matrix @ matrix).diagonal(dim1=-2, dim2=-1).sum(dim=-1).real"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Demo\nstates = torch.randn(4, 8, dtype=torch.complex64)\nstates = normalize_complex(states)\nprint('Unit norm:', torch.allclose(torch.linalg.vector_norm(states, dim=-1), torch.ones(4)))\nrho = density_from_state(states[:1])\nprint('Rho Hermitian:', is_hermitian(rho))\nprint('Tr(rho) =', float(trace_real(rho)[0]))\nprint('Purity(rho) =', float(purity(rho)[0]))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 4. Quantum Lexicon"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class QuantumLexicon(nn.Module):\n    def __init__(self, vocab_size, dimension):\n        super().__init__()\n        scale = 1.0 / math.sqrt(dimension)\n        self.real = nn.Parameter(torch.randn(vocab_size, dimension) * scale)\n        self.imag = nn.Parameter(torch.randn(vocab_size, dimension) * scale)\n    def forward(self):\n        return normalize_complex(torch.complex(self.real, self.imag))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "lex = QuantumLexicon(100, 16)\nstates = lex()\nprint('Shape:', states.shape)\nprint('Unit norm:', torch.allclose(torch.linalg.vector_norm(states, dim=-1), torch.ones(100)))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 5. EntangledMemory"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class EntangledMemory(nn.Module):\n    def __init__(self, dimension, num_relations):\n        super().__init__()\n        scale = 1.0 / math.sqrt(dimension); eye = torch.eye(dimension)\n        self.real = nn.Parameter(torch.randn(num_relations, dimension, dimension) * scale)\n        self.imag = nn.Parameter(torch.randn(num_relations, dimension, dimension) * scale)\n        with torch.no_grad(): self.real[0].copy_(eye); self.imag[0].zero_()\n        self.mixing_logits = nn.Parameter(torch.zeros(num_relations))\n    def forward(self, state):\n        ops = torch.complex(self.real, self.imag)\n        mixed = torch.softmax(self.mixing_logits, dim=0).to(ops.dtype)\n        return torch.einsum('k,bkd->bd', mixed, torch.einsum('bd,kde->bke', state, ops))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "mem = EntangledMemory(16, 4)\nx = torch.randn(2, 16, dtype=torch.complex64)\nprint('Input:', x.shape, '-> Output:', mem(x).shape)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 6. QALF Model"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "@dataclass\nclass QALFConfig:\n    vocab_size: int; dimension: int = 64; context_size: int = 24\n    num_relations: int = 4; num_components: int = 4; bigram_strength: float = 0.35\n    trigram_strength: float = 0.75; pad_id: int = 0"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class QALFModel(nn.Module):\n    def __init__(self, config, bigram_logits=None):\n        super().__init__(); self.config = config\n        self.lexicon = QuantumLexicon(config.vocab_size, config.dimension)\n        self.memory = EntangledMemory(config.dimension, config.num_relations)\n        self.phase_frequencies = nn.Parameter(torch.linspace(0.05, 1.25, config.dimension))\n        self.component_logits = nn.Parameter(torch.zeros(config.num_components))\n        self.component_phase_offsets = nn.Parameter(torch.linspace(0.0, 1.0, config.num_components))\n        self.component_centers = nn.Parameter(torch.linspace(0.0, 1.0, config.num_components))\n        self.component_log_widths = nn.Parameter(torch.full((config.num_components,), math.log(0.5)))\n        self.output_bias = nn.Parameter(torch.zeros(config.vocab_size))\n        if bigram_logits is None: bigram_logits = torch.zeros(config.vocab_size, config.vocab_size, dtype=torch.float32)\n        self.register_buffer('bigram_logits', bigram_logits.float())\n    \n    def component_weights(self, context_ids):\n        batch, length = context_ids.shape\n        positions = torch.linspace(0.0, 1.0, length, device=context_ids.device)\n        centers, widths = torch.sigmoid(self.component_centers), self.component_log_widths.exp().clamp_min(0.05)\n        weights = torch.exp(-0.5 * ((positions[None,:]-centers[:,None])/widths[:,None]).square())\n        mask = context_ids.ne(self.config.pad_id).float()\n        return weights[None,:,:,None] * mask[:,None,:,None].to(weights.dtype)\n    \n    def context_components(self, context_ids):\n        states, embedded = self.lexicon(), self.lexicon()[context_ids]\n        weights = self.component_weights(context_ids)\n        positions = torch.arange(context_ids.shape[1], device=context_ids.device, dtype=torch.float32)\n        phase_base = positions[:,None] * self.phase_frequencies[None,:]\n        phases = [torch.exp(1j * (phase_base + self.component_phase_offsets[c] * positions[:,None])) for c in range(self.config.num_components)]\n        phase = torch.stack(phases, dim=0)\n        weighted = embedded[:,None,:,:] * phase[None,:,:,:] * weights[:, :, :, :]
        components = normalize_complex(weighted.sum(dim=2))\n        empty = weights.sum(dim=-1).eq(0)\n        if empty.any(): components[empty] = states[self.config.pad_id]\n        return components\n    \n    def context_state(self, context_ids):\n        mix = torch.softmax(self.component_logits, dim=0).to(self.context_components(context_ids).dtype)\n        return normalize_complex(torch.einsum('c,bcd->bd', mix, self.context_components(context_ids)))\n    \n    def density(self, context_ids):\n        components, mix = self.context_components(context_ids), torch.softmax(self.component_logits, dim=0).to(components.dtype)\n        projectors = components.unsqueeze(-1) * components.conj().unsqueeze(-2)\n        rho = torch.einsum('c,bcde->bde', mix, projectors)\n        tr = torch.diagonal(rho, dim1=-2, dim2=-1).sum(dim=-1).real.clamp_min(1e-8)\n        return rho / tr[:, None, None].to(rho.dtype)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Demo\nconfig_demo = QALFConfig(vocab_size=len(tok.vocab), dimension=16, context_size=8, num_relations=2, num_components=2, pad_id=tok.pad_id)\nmodel = QALFModel(config_demo)\nprint('Model param count:', sum(p.numel() for p in model.parameters()))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 7. Data Pipeline"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "@dataclass\nclass DialogueExample:\n    prompt: str\n    reply: str\n\ndef read_jsonl(path):\n    return [DialogueExample(r['prompt'], r['reply']) for r in json.load(open(path)) if 'prompt' in r and 'reply' in r]\n\ndef encode_examples(tokenizer, examples): return [tokenizer.encode_example(e.prompt, e.reply) for e in examples]\n\ndef make_windows(encoded, context_size, pad_id, include_prev2=False):\n    examples, total = list(encoded), sum(max(len(e.sequence)-1,0) for e in encoded)\n    contexts = torch.full((total, context_size), pad_id, dtype=torch.long)\n    prev_tokens, targets = torch.empty(total, dtype=torch.long), torch.empty(total, dtype=torch.long)\n    prev2_tokens = torch.empty(total, dtype=torch.long) if include_prev2 else None\n    row = 0\n    for example in examples:\n        seq = example.sequence\n        for idx in range(1, len(seq)):\n            start, context = max(0, idx-context_size), seq[start:idx]\n            offset = context_size - len(context)\n            contexts[row, offset:] = torch.tensor(context, dtype=torch.long)\n            prev_tokens[row], targets[row] = seq[idx-1], seq[idx]\n            if prev2_tokens is not None:\n                prev2_tokens[row] = seq[idx-2] if idx>=2 else pad_id\n            row += 1\n    return contexts, prev2_tokens if include_prev2 else None, prev_tokens, targets"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 8. Training"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def cross_entropy_with_l2(model, logits, targets, l2_weight=1e-5, entropy_weight=0.0):\n    loss = F.cross_entropy(logits, targets)\n    relation_energy = model.memory.real.square().mean() + model.memory.imag.square().mean()\n    loss += l2_weight * relation_energy\n    if entropy_weight > 0:\n        comp_mix, rel_mix = torch.softmax(model.component_logits, dim=0), torch.softmax(model.memory.mixing_logits, dim=0)\n        comp_entropy = -(comp_mix * comp_mix.clamp_min(1e-8).log()).sum()\n        rel_entropy = -(rel_mix * rel_mix.clamp_min(1e-8).log()).sum()\n        loss -= entropy_weight * (comp_entropy + rel_entropy)\n    return loss"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 9. Attractor"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from typing import Optional\n\n@dataclass\nclass AttractorMatch:\n    prompt: str; reply: str; score: float\n\nclass PromptAttractor:\n    def __init__(self, tokenizer, examples, threshold=0.34):\n        self.tokenizer, self.threshold, self.entries = tokenizer, threshold, []\n        ignored = {tokenizer.pad_id, tokenizer.unk_id, tokenizer.bos_id, tokenizer.eos_id, tokenizer.user_id, tokenizer.assistant_id}\n        for rec in examples:\n            prompt, reply = rec.get('prompt',''), rec.get('reply','')\n            tokens = {idx for idx in tokenizer.encode(prompt) if idx not in ignored}\n            if tokens: self.entries.append((prompt, reply, tokens))\n    \n    def match(self, prompt):\n        query = set(tokenizer.encode(prompt))\n        if not query: return None\n        best = None\n        for cand_p, reply, cand in self.entries:\n            union = query | cand\n            if not union: continue\n            score = 0.65 * len(query & cand)/len(union) + 0.35 * len(query & cand)/max(len(query),1)\n            if best is None or score > best.score: best = AttractorMatch(cand_p, reply, score)\n        return best if (best and best.score >= self.threshold) else None\n    \n    def reply_or_none(self, prompt):\n        match = self.match(prompt)\n        return match.reply if match is not None else None"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### 10. Demo — End-to-end"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Mini training demo (CPU only, small config)\nprint('--- Mini Training Demo ---')\n\n# Create tiny data\nmini_data = [\n    ('What is QALF?', 'QALF is a quantum language field.'),\n    ('How does it work?', 'It uses complex numbers and density matrices.'),\n    ('Hello', 'Hi there!'),\n    ('What is 2+2?', '4'),\n    ('Hello dear', 'Hello dear, how can I help?'),\n]\n\n# Tokenize\ntok_mini = QuantumTokenizer.build([''.join(p+' '+r for p,r in mini_data)], vocab_size=100)\nexamples = [DialogueExample(p, r) for p,r in mini_data]\nencoded = encode_examples(tok_mini, examples)\ncontexts, prev2, prev_tokens, targets = make_windows(encoded, context_size=6, pad_id=tok_mini.pad_id, include_prev2=True)\nprint('Windows:', targets.numel())\n\n# Train\nprint('--- Training ---')\nfor epoch in range(10):\n    model = QALFModel(QALFConfig(vocab_size=len(tok_mini.vocab), dimension=8, context_size=6, num_relations=2, num_components=2, pad_id=tok_mini.pad_id))\n    model.train()\n    loader = torch.utils.data.DataLoader(torch.utils.data.TensorDataset(contexts, prev2, prev_tokens, targets))\n    opt = torch.optim.Adam(model.parameters(), lr=0.01)\n    for batch_ctx, batch_prev2, batch_prev, batch_tgt in loader:\n        batch_ctx, batch_prev2, batch_prev, batch_tgt = batch_ctx.to('cpu'), batch_prev2.to('cpu'), batch_prev.to('cpu'), batch_tgt.to('cpu')\n        logits = model(batch_ctx, batch_prev, batch_prev2)\n        loss = F.cross_entropy(logits, batch_tgt) + 1e-5 * (model.memory.real.square().mean() + model.memory.imag.square().mean())\n        opt.zero_grad(); loss.backward(); opt.step()\n    print(f'Epoch {epoch+1}, Loss: {loss.item():.4f}')\n\n# Generate\nprint('--- Generation ---')\nprompt = 'What is QALF?'\ngenerated = model.generate(tok_mini, prompt, max_new_tokens=20, temperature=0.0, seed=42)\nprint(f'Prompt: {prompt}')\nprint(f'Response: {generated}')"
   ]
  }
 ]
